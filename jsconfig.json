{
    "extensions": [
        "*",
        ".js",
        ".vue",
        ".json"
    ],
    "compilerOptions": {
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./public",
        "moduleResolution": "node",
        "allowJs": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./resources/js/src/*"
            ]
        }
    }
}
